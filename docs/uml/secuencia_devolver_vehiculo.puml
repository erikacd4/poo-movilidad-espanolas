@startuml
title Diagrama de secuencia: Devolver un vehículo
hide footbox
actor Usuario as Actor
participant "sistema : Sistema" as S
participant "usuario : Usuario" as U
participant "estacion : Estacion" as E
participant "viaje : Viaje" as J
participant "cuenta : Cuenta" as C
participant "suscripcion : Suscripcion" as P
participant "vehiculo : Vehiculo" as V
Actor -> S : devolverVehiculo(usuario, vehiculo, estacion, distancia)
activate S
S -> E : tieneCapacidad()
E --> S : booleano
alt la estación tiene capacidad disponible
 S -> J : finalizar(estacion, distancia)
 note right of J : Registra estación, fin y distancia.
 S -> J : calcularImporte()
 note right of J : Aplica tarifa, promociones, recargos y períodos sin cargo documentados.
 J --> S : importe
 S -> C : debitar(importe)
 note right of C : Registra el movimiento con fecha e importe.
 S -> J : cerrar()
 opt el saldo resulta negativo después del cobro
  S -> U : actualizarHabilitacion()
 end
 S -> E : agregarVehiculo(vehiculo)
 opt se aplicó el plan mensual
  S -> P : consumirViaje()
 end
 opt es el primer viaje finalizado y no cancelado
  S -> U : marcarPrimerViajeRealizado()
 end
 S -> V : agregarKilometros(distancia)
 S -> V : actualizarEstadoTrasDevolucion()
 note right of V : Si es eléctrico con batería menor al 15 %, pasa a BATERIA_BAJA.
 S -> E : calcularOcupacion()
 E --> S : ocupacion
 opt la ocupación es menor al 20 % o mayor al 90 %
  S -> S : generarAlertaRedistribucion(estacion)
 end
 S --> Actor : informa finalización, importe y saldo
else la estación está llena
 opt es el primer intento rechazado por estación llena
  S -> J : registrarInicioTiempoAdicional(momento)
  note right of J : Período adicional sin cargo de hasta 10 minutos.
 end
 S --> Actor : no cierra el viaje; ir a otra estación cercana y solicitar de nuevo
end
deactivate S
@enduml
