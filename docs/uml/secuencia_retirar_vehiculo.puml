@startuml
title Diagrama de secuencia: Retirar un vehículo
hide footbox
actor Usuario as Actor
participant "sistema : Sistema" as S
participant "usuario : Usuario" as U
participant "tarifa : Tarifa" as T
participant "cuenta : Cuenta" as C
participant "vehiculo : Vehiculo" as V
participant "estacion : Estacion" as E
Actor -> S : retirarVehiculo(usuario, vehiculo, estacion)
activate S
S -> U : tieneViajeAbierto()
U --> S : booleano
S -> U : estaHabilitado()
U --> S : habilitado
S -> S : buscarTarifaVigente(vehiculo)
S -> T : calcularSaldoMinimo()
T --> S : minimo
S -> C : alcanzaSaldoMinimo(minimo)
C --> S : booleano
alt el usuario está inhabilitado, tiene otro viaje abierto o no alcanza el saldo mínimo
 S --> Actor : informa el motivo; no registra el viaje
else el usuario puede retirar
 S -> V : puedeRetirarse()
 V --> S : booleano
 alt el vehículo no puede retirarse
  opt es eléctrico y su batería es menor al 15 %
   S -> V : cambiarEstado(BATERIA_BAJA)
  end
  S --> Actor : informa el motivo; no permite retirarlo
 else el vehículo puede retirarse
  create participant "viaje : Viaje" as J
  S -> J : Viaje(usuario, vehiculo, estacion, inicio, tarifa)
  S -> V : cambiarEstado(EN_USO)
  S -> E : retirarVehiculo(vehiculo)
  S -> E : calcularOcupacion()
  E --> S : ocupacion
  opt la ocupación es menor al 20 % o mayor al 90 %
   S -> S : generarAlertaRedistribucion(estacion)
  end
  S --> Actor : informa que el retiro se realizó correctamente
 end
end
deactivate S
@enduml
